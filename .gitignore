/reports/**/*.mp4
/reports/**/*.pdf

# New diagnostic runs: deny generated contents by default, publish compact evidence
# This also prevents copied labels, worker tokens/configs, huge JSONL predictions,
# embedded-image HTML and full hash inventories from entering Git by accident.
/reports/bus-*/**
!/reports/bus-*/*.md
!/reports/bus-*/*.py
!/reports/bus-*/summary.json

/reports/oof-*/**
!/reports/oof-*/*.md
!/reports/oof-*/*.py
!/reports/oof-*/oof_metrics.json
!/reports/oof-*/fold_summary.json
!/reports/oof-*/post_run_verification.json
!/reports/oof-*/split_verification.json
!/reports/oof-*/failure_verification.json
!/reports/oof-*/summary.json
!/reports/oof-*/review.json
!/reports/oof-*/review.csv
!/reports/oof-*/high_confidence_candidates.json
!/reports/oof-*/high_confidence_candidates.csv
!/reports/oof-*/representative_candidates.json
!/reports/oof-*/scalar_crosscheck.json
!/reports/oof-*/context_and_duplicate_checks.json

# Full per-image prediction streams are local artifacts, not source files
/reports/**/*.jsonl
# Keep the original pilot's small nested narrative without its generated data
!/reports/bus-crop-pilot/ultralytics-run/
/reports/bus-crop-pilot/ultralytics-run/*
!/reports/bus-crop-pilot/ultralytics-run/*.md

# Git publication checks are compact metadata only
/reports/git-publication-*/**
!/reports/git-publication-*/*.md
!/reports/git-publication-*/checks.json
!/reports/git-publication-*/commit_files.json
