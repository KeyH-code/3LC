{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Concise agent-first visual review batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "attempt_id", "requested_model", "reported_model", "input_manifest_sha256", "started_at", "finished_at", "vision_inputs", "results", "uncompleted_keys"],
  "properties": {
    "schema_version": {"const": "cleaning-expansion-agent-review-v1"},
    "batch_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "requested_model": {"const": "cpa/gpt-6-luna-high"},
    "reported_model": {"type": ["string", "null"]},
    "input_manifest_sha256": {"$ref": "#/$defs/hash"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "vision_inputs": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "path", "sha256", "tool", "actual_image_received", "candidate_keys"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/hash"},
          "tool": {"type": "string", "minLength": 1},
          "actual_image_received": {"type": "boolean"},
          "candidate_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}}
        }
      }
    },
    "results": {"type": "array", "items": {"$ref": "#/$defs/result"}},
    "uncompleted_keys": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "category", "confidence", "proposed_class", "final_xyxy", "object_key", "reason_code", "reason", "notes", "visual_completed", "evidence_ids"],
      "properties": {
        "key": {"$ref": "#/$defs/hash"},
        "category": {"enum": ["add_box", "change_class", "keep", "defer", "blocked"]},
        "confidence": {"enum": ["high", "medium", "low"]},
        "proposed_class": {"enum": [null, 0, 1, 2, 3]},
        "final_xyxy": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 640}}
          ]
        },
        "object_key": {"type": ["string", "null"], "maxLength": 120},
        "reason_code": {"enum": ["missing_label", "wrong_class", "model_error", "already_covered", "out_of_annotation_scope", "ambiguous_class", "ambiguous_geometry", "ambiguous_scope", "conflicting_target", "duplicate_target", "image_unavailable", "tool_failure"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 160},
        "notes": {"type": "string", "maxLength": 160},
        "visual_completed": {"type": "boolean"},
        "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {
          "if": {"properties": {"category": {"enum": ["add_box", "change_class", "keep"]}}},
          "then": {"properties": {"confidence": {"const": "high"}, "visual_completed": {"const": true}, "evidence_ids": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"category": {"const": "add_box"}}},
          "then": {"properties": {"proposed_class": {"enum": [0, 1, 2, 3]}, "final_xyxy": {"type": "array"}, "object_key": {"type": "string", "minLength": 1}, "reason_code": {"const": "missing_label"}}}
        },
        {
          "if": {"properties": {"category": {"const": "change_class"}}},
          "then": {"properties": {"proposed_class": {"enum": [0, 1, 2, 3]}, "final_xyxy": {"type": "null"}, "object_key": {"type": "null"}, "reason_code": {"const": "wrong_class"}}}
        },
        {
          "if": {"properties": {"category": {"enum": ["keep", "defer", "blocked"]}}},
          "then": {"properties": {"proposed_class": {"type": "null"}, "final_xyxy": {"type": "null"}, "object_key": {"type": "null"}}}
        },
        {
          "if": {"properties": {"category": {"const": "defer"}}},
          "then": {"properties": {"visual_completed": {"const": true}, "evidence_ids": {"minItems": 1}, "reason_code": {"enum": ["ambiguous_class", "ambiguous_geometry", "ambiguous_scope", "conflicting_target", "duplicate_target"]}}}
        },
        {
          "if": {"properties": {"category": {"const": "blocked"}}},
          "then": {"properties": {"visual_completed": {"const": false}, "confidence": {"const": "low"}, "reason_code": {"enum": ["image_unavailable", "tool_failure"]}}}
        },
        {
          "if": {"properties": {"category": {"const": "keep"}}},
          "then": {"properties": {"reason_code": {"enum": ["model_error", "already_covered", "out_of_annotation_scope", "duplicate_target"]}}}
        }
      ]
    }
  },
  "$comment": "Structural protocol only. Receiver must additionally enforce batch/key partition, unique result keys/evidence IDs, actual image identity/hash, evidence linkage, x1<x2/y1<y2, stable GT mapping, proposed class change, target deduplication, append-only provenance and approval gates. reported_model=null when runtime does not expose it. Do not infer calibrated error probability from confidence."
}
